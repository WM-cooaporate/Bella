# Copy to .env for local development. Never commit a populated .env.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only-secret
SUPABASE_STORAGE_BUCKET=bella-private
CRON_SECRET=replace-with-a-different-random-secret
BELLA_CORS_ORIGIN=http://localhost:5173
BELLA_ADMIN_USERNAME=store-admin
BELLA_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
PORT=3000
